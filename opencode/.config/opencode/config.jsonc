{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "metabase": {
      "type": "http",
      "url": "http://localhost:3000/api/mcp",
      "enabled": true
    },
    "azure-devops": {
      "type": "local",
      "command": ["npx", "-y", "@azure-devops/mcp", "proxionsolutions"],
      "enabled": true
    }
  }
}
